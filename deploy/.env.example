# The host name browsers and devices reach the hub on. It must resolve to this
# machine, with ports 80 and 443 open, so Caddy can get a certificate for it.
FORGITTEN_HOST=forgitten.example.org

# A release tag without the v, like 0.2.0. Defaults to the latest release.
# FORGITTEN_VERSION=

# scripts/entra-app.sh https://forgitten.example.org prints all four.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
